{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"types": ["../../node_modules/@ragempcommunity/types-client"],
		"baseUrl": "./",
		"paths": {
			"@shared/*": ["../shared/*"],
			"@shared-rage/*": ["../shared-rage/*"],
			"@/*": ["./*"]
		}
	},
	"include": ["./**/*.ts", "../shared/**/*.ts", "../shared-rage/**/*.ts"],
	"exclude": ["../shared/**/*.d.ts"]
}
